{
  "name": "holomotion-3d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run check:assets && tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0",
    "postinstall": "node scripts/assets.mjs",
    "setup:assets": "node scripts/assets.mjs",
    "check:assets": "node scripts/assets.mjs --check",
    "build:ui": "tsc -b && vite build",
    "test:browser": "node tests/browser/drawing.cjs && node tests/browser/spatial.cjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.0"
  }
}
